# Frontend build-time variables (passed as build args to likelee-ui)
# Fill these and copy to deploy/ec2/.env before building on EC2.

# Supabase (public anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API base URL the frontend uses. When running behind the gateway, set to /api
VITE_API_BASE_URL=/api

# Brand trial period (days, default: 14, max: 365)
VITE_BRAND_TRIAL_DAYS=14
