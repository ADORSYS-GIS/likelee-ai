# Staging Environment Variables
# Copy this file to .env and fill in the values before deploying.

# ==========================================
# Frontend build-time variables
# ==========================================
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key
VITE_API_BASE_URL=/api
VITE_BRAND_TRIAL_DAYS=14

# ==========================================
# Backend runtime variables
# ==========================================
DATABASE_URL=postgresql://postgres:your-password@db.your-staging-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_KEY=your-staging-service-key
JWT_SECRET=your-staging-jwt-secret
APP_ENV=staging

# ==========================================
# Stripe (use test mode for staging)
# ==========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==========================================
# AWS / Other services (staging/test values)
# ==========================================
AWS_REGION=eu-central-1
