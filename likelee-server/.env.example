# Supabase (PostgREST) service credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Server
PORT=8787
FRONTEND_URL=http://localhost:5173

# Supabase Storage buckets
SUPABASE_BUCKET_PRIVATE=likelee-private
SUPABASE_BUCKET_PUBLIC=likelee-public
SUPABASE_BUCKET_TEMP=likelee-temp

# ElevenLabs (optional, for server-side TTS synthesis)
ELEVENLABS_API_KEY=

# Veriff API config (from Veriff Customer Portal -> Integrations)
VERIFF_BASE_URL=https://veriff.me.api
VERIFF_API_KEY=your-veriff-api-key
VERIFF_SHARED_SECRET=your-veriff-shared-secret

# KYC testing (temporary)
# If true, bypasses the agency Veriff monthly session limit check (default: false)
KYC_BYPASS_VERIFF_LIMIT=false


# Stripe Connect (for payouts / bank connection)
PAYOUTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_RETURN_URL=https://your-frontend-domain/stripe/connect/return
STRIPE_REFRESH_URL=https://your-frontend-domain/stripe/connect/refresh
STRIPE_WEBHOOK_SECRET=

AGENCY_PAYOUT_SCHEDULER_ENABLED=false
AGENCY_PAYOUT_SCHEDULER_INTERVAL_SECS=3600

# Stripe Subscriptions (Agency billing)
# Legacy / backward-compatible price IDs (still used for older subscriptions)
STRIPE_AGENCY_PRICE_ID=
STRIPE_SCALE_PRICE_ID=

# Stripe Subscriptions (Agency billing - new pricing page)
STRIPE_AGENCY_IRL_BOOKING_PRICE_ID=
STRIPE_AGENCY_PRO_HEADCOUNT_PRICE_ID=
STRIPE_AGENCY_PRO_BASE_PRICE_ID=
STRIPE_AGENCY_BASIC_BASE_PRICE_ID=
STRIPE_AGENCY_BASIC_HEADCOUNT_PRICE_ID=
STRIPE_AGENCY_BASIC_BASE_ANNUAL_PRICE_ID=
STRIPE_AGENCY_IRL_BOOKING_ANNUAL_PRICE_ID=
STRIPE_AGENCY_PRO_HEADCOUNT_ANNUAL_PRICE_ID=
STRIPE_AGENCY_PRO_BASE_ANNUAL_PRICE_ID=
STRIPE_AGENCY_BASIC_HEADCOUNT_ANNUAL_PRICE_ID=

# Stripe Subscriptions (Creator billing)
STRIPE_CREATOR_BASIC_PRICE_ID=
STRIPE_CREATOR_PRO_PRICE_ID=
STRIPE_CREATOR_BASIC_ANNUAL_PRICE_ID=
STRIPE_CREATOR_PRO_ANNUAL_PRICE_ID=
STRIPE_CREATOR_SUCCESS_URL=http://localhost:5173/CreatorSubscribe?success=1&session_id={CHECKOUT_SESSION_ID}
STRIPE_CREATOR_CANCEL_URL=http://localhost:5173/CreatorSubscribe?canceled=1

STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/agencysubscribe?success=1
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/agencysubscribe?canceled=1

# Stripe Subscriptions (Brand billing)
STRIPE_BRAND_BASIC_PRICE_ID=
STRIPE_BRAND_BASIC_ANNUAL_PRICE_ID=
STRIPE_BRAND_PRO_PRICE_ID=
STRIPE_BRAND_PRO_ANNUAL_PRICE_ID=
STRIPE_BRAND_STUDIO_ADDON_PRICE_ID=

# Stripe Subscriptions (Client licensing / package paywall)
STRIPE_LICENSING_BASIC_PRICE_ID=
STRIPE_LICENSING_PRO_PRICE_ID=
STRIPE_LICENSING_ENTERPRISE_PRICE_ID=
STRIPE_LICENSING_SUCCESS_URL=http://localhost:5173/share/package/{PACKAGE_TOKEN}?licensing=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_LICENSING_CANCEL_URL=http://localhost:5173/share/package/{PACKAGE_TOKEN}?licensing=canceled

# Stripe (Studio credit packs)
STRIPE_STUDIO_SUCCESS_URL=http://localhost:5173/studiosubscribe?success=1&session_id={CHECKOUT_SESSION_ID}
STRIPE_STUDIO_CANCEL_URL=http://localhost:5173/studiosubscribe?canceled=1
STRIPE_STUDIO_LITE_PRICE_IDS=300:price_...
STRIPE_STUDIO_PRO_PRICE_IDS=2000:price_...,5000:price_...,10000:price_...
# Backwards-compatible fallback (if plan-specific vars not set)
STRIPE_STUDIO_PRICE_IDS=2000:price_...,5000:price_...,10000:price_...

# Payout settings
PAYOUT_AUTO_APPROVE_THRESHOLD_CENTS=500000
MIN_PAYOUT_AMOUNT_CENTS=1000
INSTANT_PAYOUTS_ENABLED=true
PAYOUT_FEE_BPS=100
PAYOUT_CURRENCY=USD
PAYOUT_ALLOWED_CURRENCIES=USD,EUR

# DocuSeal Configuration (Contract Management)
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_APP_URL=https://docuseal.co
DOCUSEAL_WEBHOOK_URL=
DOCUSEAL_USER_EMAIL=
DOCUSEAL_MASTER_TEMPLATE_ID=
DOCUSEAL_MASTER_TEMPLATE_NAME=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@likelee.ai
# EMAIL_CONTACT_TO=support@likelee.ai

# SMTP (Sales/Contact) Configuration
SMTP_SALES_HOST=
SMTP_SALES_PORT=587
SMTP_SALES_USER=
SMTP_SALES_PASSWORD=
EMAIL_FROM_SALES=operations@likelee.ai
EMAIL_SALES_TO=operations@likelee.ai

# Studio Provider API Keys (for AI generation: Fal)
FAL_API_KEY=
FAL_API_URL=https://queue.fal.run

# Calendly Integration (IRL Booking)
CALENDLY_BOOKING_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_API_TOKEN=

# Cache Configuration (Multi-Level Caching)
# TTL for L2 session cache entries in seconds (default: 30 min)
CACHE_L2_TTL_SECS=1800
# TTL for L3 application cache entries in seconds (default: 1 hour)
CACHE_L3_TTL_SECS=3600
# Interval for L3 background refresh in seconds (default: 5 min)
CACHE_L3_REFRESH_SECS=300
# Maximum entries in L2 session cache (default: 10000)
CACHE_L2_MAX_ENTRIES=10000
# Maximum entries in L3 application cache (default: 1000)
CACHE_L3_MAX_ENTRIES=1000
# TTL for idempotency records in seconds (default: 24 hours)
CACHE_IDEMPOTENCY_TTL_SECS=86400

# Cron Job Authentication
# Secret token for authenticating cron job endpoints (budget alerts, monthly resets)
# Generate a secure random string: openssl rand -hex 32
CRON_SECRET=your-secure-random-token-here
